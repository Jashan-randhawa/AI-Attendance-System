# Backend API URL
VITE_API_URL=https://your-backend.onrender.com

# API key sent as the X-API-Key header on every request (Phase 4 remediation:
# every read and write endpoint now requires an operator or admin key).
# Use an operator key for day-to-day use (sessions, mark attendance) or an
# admin key for enrollment/deletion/reports/exports as well.
VITE_API_KEY=your-operator-or-admin-key
