# ── App Security ────────────────────────────────────────────────────────────
# Role-separated shared-secret API keys (Phase 0 + Phase 3 RBAC hardening).
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Each var accepts a comma-separated list of keys, to support zero-downtime
# rotation (add the new key, roll it out, then remove the old one).
#
#   API_KEY_ADMIN     — enroll/delete persons, CSV export, /debug-* endpoints.
#   API_KEY_OPERATOR  — create/end sessions, mark attendance.
#                        (an admin key also works on operator endpoints)
#
# A role with NO key configured fails closed (503) rather than silently
# allowing unauthenticated access — never leave both blank in a deployed
# environment.
API_KEY_ADMIN=
API_KEY_OPERATOR=

# Legacy Phase 0 var — still honored as an additional admin key for backward
# compatibility with deployments that predate the operator/admin split above.
# New deployments should use API_KEY_ADMIN / API_KEY_OPERATOR instead.
API_KEY=

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=attendance_db

# ── Microsoft Azure Blob Storage (optional — enrollment photo hosting) ────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_BLOB_CONTAINER=attendance-photos          # Auto-created on first enroll

# ── Face Recognition Settings ─────────────────────────────────────────────────
# MIN_CONFIDENCE: minimum cosine similarity to accept a live-attendance match.
#   Lower = more lenient (more false positives). Raise to 0.60+ for high-security.
MIN_CONFIDENCE=0.40

# DUPLICATE_THRESHOLD: similarity above which a new enrollment is rejected as
# a duplicate of an existing person. Must be >= MIN_CONFIDENCE.
#   Lower = stricter duplicate detection (more false positives on twins/lookalikes).
DUPLICATE_THRESHOLD=0.45

# ── App Settings ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
